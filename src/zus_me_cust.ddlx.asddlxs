@Metadata.layer: #CUSTOMER
annotate entity ZUS_I_CUST
    with 
{
 @UI.identification: [{ position: 10, label: 'Customer No' }]
 CustId;
 
  @UI.identification: [{ position: 20, label: 'Customer Name' }]
  Name;
  
   @UI.identification: [{ position: 30, label: 'Customer Company Name' }]
   CompanyName;
   
    @UI.identification: [{ position: 10, label: 'Customer Country' }]
    Country;
    
     @UI.identification: [{ position: 10, label: 'Customer City' }]
     City;
     
      @UI.identification: [{ position: 10, label: 'Customer Mobile' }]
      Mobile;
    
}