@Metadata.layer: #CUSTOMER
annotate entity ZUS_RC_SOIT
    with 
{
    
    @UI.lineItem: [{ position: 10, label: 'Order No' }]
    @UI.identification: [{ position: 10, label: 'Order No' }]
    @UI.selectionField: [{ position: 1 }]
    @EndUserText.label: 'Order ID'
    Soid;  
    
    @UI.lineItem: [{ position: 20, label: 'Item' }]
        @UI.identification: [{ position: 20, label: 'Item' }]
    @Search.defaultSearchElement: true
    @EndUserText.label: 'Item ID'
    ItemId;  
    
    @UI.lineItem: [{ position: 30, label: 'Product' }] 
        @UI.identification: [{ position: 30, label: 'Product' }]
    @UI.selectionField: [{ position: 9 }]
    @EndUserText.label: 'Product'
    @Consumption.valueHelpDefinition: [{ entity: {name : 'ZUS_I_PROD', 
    element : 'ProdId' }}]
    Product;  
    
    @UI.lineItem: [{ position: 40, label: 'Amount' }]
        @UI.identification: [{ position: 40, label: 'Amount' }]
    @UI.dataPoint : { qualifier : 'Amount',
    criticality : 'ItemId'
    } 
    Amount ;
    
}