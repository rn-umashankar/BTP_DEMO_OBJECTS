managed implementation in class zbp_us_ri_so unique;
strict ( 2 );

with draft;

define behavior for zus_RI_SO //alias <alias_name>
persistent table zvkfeb01_dt_so
draft table zvkfeb01_dtf_so
lock master total etag ChangedOn
authorization master ( instance )
etag master changedOn
{
  create ( authorization : global );
  update;
  delete;

  field ( readonly : update ) Soid;
  field ( readonly ) ApprovalTimestamp;
  field ( mandatory : create ) Buyer; //: create
  association _Item { create; }

  validation validatesalesdats on save { field ApprovalTimestamp;  create; }

//  validation setbuyer on save  { field Buyer; create; }

  determination determineappdata on save { field SalesTimestamp ; }

   draft action Activate;
   draft action Resume;
   draft action Edit;
   draft action Discard;

   draft determine action Prepare;

    action  ( features : instance ) customaction result[1]$self;

mapping for zvkfeb01_dt_so
{

    Soid  =   Soid;
    Buyer = buyer;
    SalesPerson       = sales_person;
    SalesTimestamp    = sales_timestamp;
    SalesManager      = sales_manager;
    ApprovalTimestamp = approval_timestamp;
    CreatedBy = created_by;
    CreatedOn = created_on;
    ChangedBy = changed_by;
    ChangedOn = changed_on;
    Url       = url;

}
}

define behavior for ZUS_IE_SOIT //alias <alias_name>
persistent table zvkfeb01_dt_soit
draft table zvkfeb01_dtf_soi
lock dependent by _Header
authorization dependent by _Header
//etag master <field_name>
{
  update;
  delete;
  field ( readonly ) Soid, ItemId;
  association _Header;

  mapping for zvkfeb01_dt_soit
  {

    Soid                =   soid ;
    ItemId              =   item_id  ;
    Product             =   product ;
    Amount              =   amount ;
    Currency            =   currency ;
    SalesPerson         =   sales_person ;
    SalesTimestamp      =   sales_timestamp ;
    SalesManager        =   sales_manager ;
    ApprovalTimestamp   =   approval_timestamp ;
    ChangedBy           =   changed_by ;
    ChangedOn           =   changed_on ;

  }
}