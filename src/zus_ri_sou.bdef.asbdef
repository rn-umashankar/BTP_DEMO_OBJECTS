unmanaged implementation in class zbp_us_ri_sou unique;
strict ( 2 );

define behavior for ZUS_RI_SOU //alias <alias_name>
//late numbering
lock master
authorization master ( instance )
//etag master <field_name>
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly ) Soid;
  association _Item { create; }

mapping for zvkfeb01_dt_so
